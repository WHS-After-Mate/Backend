# 서버
PORT=4100
NODE_ENV=development
CORS_ORIGIN=*

# server/와 반드시 같은 Supabase 프로젝트를 가리켜야 한다 (emr_* 테이블도, claim 대상인
# profiles/care_records 등도 전부 같은 DB에 있음 — Settings > API에서 확인)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# 클리닉 관리자 로그인 토큰 서명 비밀키 — 아무 긴 임의 문자열이면 됨(최소 16자)
ADMIN_JWT_SECRET=change-this-to-a-long-random-string
