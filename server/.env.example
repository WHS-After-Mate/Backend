# 서버
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# Supabase (Settings > API에서 확인)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxx
SUPABASE_ANON_KEY=xxxxx

# 비밀번호 재설정 이메일의 딥링크 대상 (선택, 미설정 시 Supabase 기본 Site URL 사용)
# PASSWORD_RESET_REDIRECT_URL=https://example.com/reset-password

# Anthropic (Claude) — daily-guide / questions 두 호출 지점. 선택(비워두면 서버는 정상 기동하고
# daily-guide는 검수 가이드로 폴백, questions는 ANSWER_GENERATION_FAILED로 응답. 그 외 API는 무관)
# ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# Firebase Cloud Messaging (Android 푸시) — Firebase 콘솔에서 서비스 계정 JSON 발급
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json
FCM_ENABLED=false
