# 서버
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# Supabase (Settings > API에서 확인)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxx
SUPABASE_ANON_KEY=xxxxx

# phoneVerifiedToken 서명 비밀키 (openssl rand -hex 32 등으로 생성)
APP_TOKEN_SECRET=xxxxx

# Anthropic (Claude) — daily-guide / questions 두 호출 지점
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# SMS 인증 (회원가입 전화번호 인증) — 국내 SMS 업체 발급값으로 교체
SMS_PROVIDER_API_KEY=xxxxx
SMS_PROVIDER_SENDER=xxxxx
# 개발 중에는 실제 SMS 대신 콘솔에 코드만 출력
SMS_DEV_MODE=true

# Firebase Cloud Messaging (Android 푸시) — Firebase 콘솔에서 서비스 계정 JSON 발급
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json
FCM_ENABLED=false
